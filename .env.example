# ============================================
# Notion Configuration
# ============================================
# Notion API Key 생성: https://www.notion.so/my-integrations
NOTION_API_KEY=your_notion_api_key_here

# Notion Database ID (스케줄 관리 데이터베이스)
# 예: a96a3b8563e342908b2f0af8960370b7
NOTION_DATABASE_ID=a96a3b8563e342908b2f0af8960370b7

# ============================================
# Google Calendar Configuration
# ============================================
# 대상 캘린더 ID (모든 일정이 여기로 저장됨)
# 윤윤남매 가족일정: iothomepyu@gmail.com
GOOGLE_CALENDAR_ID=iothomepyu@gmail.com

# Google OAuth 인증 파일 (credentials.json)
# 다운로드: https://console.cloud.google.com/ → OAuth 2.0 클라이언트 ID → JSON 다운로드
GOOGLE_CREDENTIALS_FILE=credentials.json

# 또는 refresh token 방식 (위의 파일이 없는 경우)
# 생성 방법: https://console.developers.google.com/ → OAuth 2.0 설정 후 토큰 발급
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# ============================================
# Anthropic Claude Configuration
# ============================================
# Claude API Key 생성: https://console.anthropic.com/
# 모델: claude-haiku-4-5-20251001 (온도: 0.2, Top P: 0.9)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================
# Sync Configuration
# ============================================
SYNC_ENABLED=true

# 선택사항: 로깅 레벨 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
